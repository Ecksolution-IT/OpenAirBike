      "revision": "v1.0 (2023-08-01)"
    }
  ],
  "errata": [
    {
      "id": "E8991",
      "description": "Apply corrected signed and resolution definitions from ESR11.",
      "source": ["esr11"]
    },
    {
      "id": "E9135",
      "description": "Apply corrected Cross Trainer field definitions, including stride count resolution 0.1 stride.",
      "source": ["esr11", "gss-r3"]
    },
    {
      "id": "EC23224",
      "description": "Apply the replacement FTMS 1.0 Section 1.1 conformance language: each capability and each supported implementation option shall be supported as specified.",
      "source": ["ec-23224"]
    }
  ],
